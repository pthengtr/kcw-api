+export async function countKbPartsMissingEmbedding(): Promise<number> {
+  const supabase = await createClient();
+
+  const { count, error } = await supabase
+    .schema("kb")
+    .from("kb_parts")
+    .select("id", { count: "exact", head: true })
+    .is("embedding", null);
+
+  if (error) {
+    console.error("countKbPartsMissingEmbedding error", error);
+    return 0;
+  }
+
+  return count ?? 0;
+}
