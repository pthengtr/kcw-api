+export async function reembedMissingKbPartsAction() {
+  const supabase = await createClient();
+
+  const { data: rows, error: listError } = await supabase
+    .schema("kb")
+    .from("kb_parts")
+    .select("id, title, keywords")
+    .is("embedding", null)
+    .order("id", { ascending: true })
+    .limit(100);
+
+  if (listError) {
+    console.error("reembedMissingKbPartsAction list error", listError);
+    redirect("/kb?error=reembed_failed");
+  }
+
+  const missing = rows ?? [];
+  if (missing.length === 0) {
+    redirect("/kb?reembedded=0");
+  }
+
+  let updated = 0;
+
+  for (const row of missing) {
+    const embeddingInput = buildKbEmbeddingInput({
+      title: row.title,
+      keywords: row.keywords,
+    });
+
+    if (!embeddingInput) {
+      continue;
+    }
+
+    try {
+      const vector = await generateKbEmbedding(embeddingInput);
+      const { error: updateError } = await supabase
+        .schema("kb")
+        .from("kb_parts")
+        .update({
+          embedding: toPgVectorLiteral(vector),
+          updated_at: new Date().toISOString(),
+        })
+        .eq("id", row.id);
+
+      if (updateError) {
+        console.error("reembedMissingKbPartsAction update error", {
+          id: row.id,
+          error: updateError,
+        });
+        redirect(`/kb?error=reembed_failed&reembedded=${updated}`);
+      }
+
+      updated += 1;
+    } catch (error) {
+      console.error("reembedMissingKbPartsAction embed error", {
+        id: row.id,
+        error,
+      });
+      redirect(`/kb?error=reembed_failed&reembedded=${updated}`);
+    }
+  }
+
+  revalidatePath("/kb");
+  redirect(`/kb?reembedded=${updated}`);
+}
