[Unit]
Description=KCW HQ purchase order / สั่งซื้อ (:8793)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/kcw-api
EnvironmentFile=%h/projects/kcw-api/.env
Environment=TZ=Asia/Bangkok
ExecStart=%h/projects/kcw-api/.venv/bin/python -m uvicorn app.hq_po_app:app --host 0.0.0.0 --port 8793
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
