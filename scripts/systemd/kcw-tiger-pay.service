[Unit]
Description=KCW Tiger Pay companion (LAN :8000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/kcw-api
EnvironmentFile=%h/projects/kcw-api/.env
Environment=TZ=Asia/Bangkok
# Four workers so tills can poll in parallel. Blocking companion routes run in
# a threadpool; only one worker holds the device poller lock.
ExecStart=%h/projects/kcw-api/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4 --timeout-keep-alive 5 --backlog 2048
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

