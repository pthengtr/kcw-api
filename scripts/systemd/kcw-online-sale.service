[Unit]
Description=KCW online sale / ขายออนไลน์ TAD+CNTAD+TO (:8796)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/kcw-api
EnvironmentFile=%h/projects/kcw-api/.env
Environment=TZ=Asia/Bangkok
ExecStart=%h/projects/kcw-api/.venv/bin/python -m uvicorn app.online_sale_app:app --host 0.0.0.0 --port 8796
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
