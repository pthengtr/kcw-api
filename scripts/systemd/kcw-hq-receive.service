[Unit]
Description=KCW HQ vendor goods receive / รับสินค้าเข้า (:8795)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/kcw-api
EnvironmentFile=%h/projects/kcw-api/.env
Environment=TZ=Asia/Bangkok
ExecStart=%h/projects/kcw-api/.venv/bin/python -m uvicorn app.hq_receive_app:app --host 0.0.0.0 --port 8795
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
