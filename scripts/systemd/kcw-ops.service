[Unit]
Description=KCW ops live PO LAN+Tailscale UI (:8790)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/kcw-api
EnvironmentFile=%h/projects/kcw-api/.env
Environment=TZ=Asia/Bangkok
ExecStart=%h/projects/kcw-api/.venv/bin/python -m uvicorn app.ops_app:app --host 0.0.0.0 --port 8790
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
