[Unit]
Description=KCW receive notes / รับชำระลูกหนี้ HQ-only LAN+Tailscale UI (:8797)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/kcw-api
EnvironmentFile=%h/projects/kcw-api/.env
Environment=TZ=Asia/Bangkok
ExecStart=%h/projects/kcw-api/.venv/bin/python -m uvicorn app.receive_notes_app:app --host 0.0.0.0 --port 8797
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
